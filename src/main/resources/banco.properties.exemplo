# Modelo de configuracao do banco.
# Copie para banco.properties e ajuste com os dados da sua maquina:
#   cp src/main/resources/banco.properties.exemplo src/main/resources/banco.properties
#
# No Mac com Postgres.app ou Homebrew o usuario e o seu login do sistema
# (rode "whoami") e a senha fica em branco. No Windows e no Linux costuma
# ser o usuario postgres com a senha definida na instalacao.
#
# Da pra sobrescrever por variavel de ambiente tambem:
#   PROVEDOR_DB_URL / PROVEDOR_DB_USER / PROVEDOR_DB_PASSWORD
db.url=jdbc:postgresql://localhost:5432/provedor_db
db.usuario=postgres
db.senha=postgres
